#############################################################################
## GNU Makefile for building gcc-mcdc COTS testsuite


# Define the C compiler, linker and debugger
CC = gcc
LN = gcc
CFLAGS = -std=c17 -Wall -Wstrict-prototypes -Wundef \
#         -DSOFTWARE_LITTLE_BIT_ORDER -D_EL -D_ix86_ -DUT_VERBOSE \
#		 -O0 -fprofile_arcs -ftest-coverage -fcondition-coverage \
#		 $(INCLUDES) 

CFLAGS = -O0 -fprofile-arcs -ftest-coverage -fcondition-coverage
		 
TARGET = add_tests

SRCS = additional_gcc_testsuite.c

DEBUGGER = -g

###############################################################################
## Rule to make the specified TARGET
##
%.exe: %.o
	$(LN) $^ -o $*.exe

###############################################################################
##  "C" COMPILER RULE
##
%.o: %.c
	$(CC) -c $(CFLAGS) $<
	
##############################################################################
##

.PHONY: all clean run gcov

all: clean $(TARGET) run gcov

$(TARGET): $(OBJS) 
	$(CC) $(CFLAGS) -o $(TARGET) $(SRCS)
	
clean ::
	rm -f add_tests rm -f *.gcda *.gcno *.o

gcov ::
	gcov -abcdfgH additional_gcc_testsuite.c -o add_tests-additional_gcc_testsuite

run ::
		./add_tests
